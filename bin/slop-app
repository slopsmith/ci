#!/usr/bin/env bash
# Packaging and upload checks shared by the slopsmith macOS apps. See README.md.
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: slop-app COMMAND [ARGS]

Commands:
  commit                     Prints the commit to stamp a build with: $SLOP_COMMIT
                             if set, else HEAD, with "-dirty" when tracked files differ.
  plist APP KEY=VALUE...     Writes APP/Contents/Info.plist. Keys: executable, id, name,
                             category, version, commit.
  nix-libs APP BINARY...     Copies the /nix/store libraries the binaries (paths inside
                             APP) need into Contents/Frameworks and points them there.
  licenses APP DIR [CARGO_MANIFEST]
                             Copies the license texts in DIR into Contents/Resources/Licenses
                             and adds the notices of the Rust crates the manifest builds.
  sign APP ENTITLEMENTS BINARY
                             Signs everything ad hoc, BINARY with ENTITLEMENTS.
  check APP BINARY           The upload checks: bundle complete, signatures, BINARY runs
                             from the bundle and reports the bundle's commit, licenses.
  zip APP OUT                Writes APP into the zip archive OUT.
EOF
}

tools() { env -u SDKROOT -u DEVELOPER_DIR "$@"; }
otool() { tools /usr/bin/otool "$@"; }
install_name_tool() { tools /usr/bin/install_name_tool "$@"; }
codesign() { tools /usr/bin/codesign "$@"; }
plist_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null; }
die() {
	echo "error: $*" >&2
	exit 1
}

cmd_commit() {
	if [ -n "${SLOP_COMMIT:-}" ]; then
		echo "$SLOP_COMMIT"
		return
	fi
	local sha
	sha=$(git rev-parse HEAD)
	if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
		sha="$sha-dirty"
	fi
	echo "$sha"
}

cmd_plist() {
	local app=$1
	shift
	local executable="" id="" name="" category="" version="" commit=""
	local kv
	for kv in "$@"; do
		case $kv in
		executable=*) executable=${kv#*=} ;;
		id=*) id=${kv#*=} ;;
		name=*) name=${kv#*=} ;;
		category=*) category=${kv#*=} ;;
		version=*) version=${kv#*=} ;;
		commit=*) commit=${kv#*=} ;;
		*) die "plist: unknown key in $kv" ;;
		esac
	done
	for kv in executable id name category version commit; do
		[ -n "${!kv}" ] || die "plist: $kv is missing"
	done
	mkdir -p "$app/Contents"
	cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>$executable</string>
	<key>CFBundleIdentifier</key><string>$id</string>
	<key>CFBundleName</key><string>$name</string>
	<key>CFBundleDisplayName</key><string>$name</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$version</string>
	<key>CFBundleVersion</key><string>$version</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.$category</string>
	<key>LSMinimumSystemVersion</key><string>26.0</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>SlopCommit</key><string>$commit</string>
</dict>
</plist>
PLIST
}

nix_deps() { otool -L "$1" | awk 'NR > 1 && $1 ~ /^\/nix\/store\// { print $1 }'; }
rpaths() { otool -l "$1" | awk '/LC_RPATH/ { getline; getline; print $2 }'; }

# Nix's builds of Apple's own libresolv and libiconv (Apple's versions number
# in the hundreds; GNU libiconv's start with 1.) are what macOS has in /usr/lib.
# They are linked from there instead of bundled, so APSL code is not shipped.
system_lib() {
	local package
	package=$(echo "$1" | cut -d/ -f4 | cut -d- -f2-)
	case $package in
	libresolv-[0-9]* | libiconv-[1-9][0-9][0-9]*) echo "/usr/lib/$(basename "$1")" ;;
	esac
}

# Two different libraries can share a file name (Apple's and GNU's libiconv),
# so the second one gets its store hash as a prefix.
cmd_nix_libs() {
	local app=$1
	shift
	local frameworks=$app/Contents/Frameworks
	mkdir -p "$frameworks"
	local copied
	copied=$(mktemp)
	local queue=() bin
	for bin in "$@"; do queue+=("$app/$bin"); done

	local file dep name dest hash system
	while ((${#queue[@]})); do
		file=${queue[0]}
		queue=("${queue[@]:1}")
		for dep in $(nix_deps "$file"); do
			system=$(system_lib "$dep")
			if [ -n "$system" ]; then
				install_name_tool -change "$dep" "$system" "$file" 2>/dev/null
				continue
			fi
			name=$(awk -v d="$dep" '$1 == d { print $2 }' "$copied")
			if [ -z "$name" ]; then
				name=$(basename "$dep")
				if [ -e "$frameworks/$name" ]; then
					hash=$(echo "$dep" | cut -d/ -f4 | cut -c1-8)
					name="$hash-$name"
				fi
				dest=$frameworks/$name
				cp "$dep" "$dest"
				chmod u+w "$dest"
				install_name_tool -id "@rpath/$name" "$dest" 2>/dev/null
				echo "$dep $name" >>"$copied"
				queue+=("$dest")
			fi
			install_name_tool -change "$dep" "@rpath/$name" "$file" 2>/dev/null
		done
	done
	rm -f "$copied"

	local lib rp
	for lib in "$frameworks"/*.dylib; do
		[ -e "$lib" ] || continue
		for rp in $(rpaths "$lib"); do
			install_name_tool -delete_rpath "$rp" "$lib" 2>/dev/null
		done
		install_name_tool -add_rpath "@loader_path" "$lib" 2>/dev/null
	done
	for bin in "$@"; do
		for rp in $(rpaths "$app/$bin"); do
			case $rp in /nix/store/*) install_name_tool -delete_rpath "$rp" "$app/$bin" 2>/dev/null ;; esac
		done
		install_name_tool -add_rpath "@executable_path/../Frameworks" "$app/$bin" 2>/dev/null
	done
	rmdir "$frameworks" 2>/dev/null || true
}

cmd_licenses() {
	local app=$1 dir=$2 manifest=${3:-}
	local out=$app/Contents/Resources/Licenses
	rm -rf "$out"
	mkdir -p "$out"
	cp -R "$dir"/. "$out/"
	if [ -n "$manifest" ]; then
		local share
		share=$(cd "$(dirname "${BASH_SOURCE[0]}")/../share/slop-app" && pwd)
		cargo about generate --fail --manifest-path "$manifest" \
			-c "$share/about.toml" "$share/about.hbs" >"$out/Rust crates.txt"
	fi
}

cmd_sign() {
	local app=$1 entitlements=$2 binary=$3
	local f
	for f in "$app/Contents/Frameworks/"*.dylib; do
		[ -e "$f" ] && codesign -s - -f "$f" 2>/dev/null
	done
	for f in "$app/Contents/MacOS/"*; do
		[ "$f" = "$app/$binary" ] && continue
		codesign -s - -f "$f"
	done
	codesign -s - -f --entitlements "$entitlements" "$app/$binary"
	codesign -s - -f "$app"
}

machos() {
	local f
	for f in "$1/Contents/MacOS/"* "$1/Contents/Frameworks/"*; do
		[ -f "$f" ] && file -b "$f" | grep -q Mach-O && echo "$f"
	done
	return 0
}

cmd_check() {
	local app=$1 binary=$2
	local failed=0
	fail() {
		echo "check failed: $*" >&2
		failed=1
	}
	ok() { echo "ok: $*"; }

	[ -d "$app" ] || die "$app does not exist"
	/usr/bin/plutil -lint -s "$app/Contents/Info.plist" || fail "Info.plist is not valid"
	local exe min commit
	exe=$(plist_get "$app" CFBundleExecutable) || fail "Info.plist has no CFBundleExecutable"
	min=$(plist_get "$app" LSMinimumSystemVersion) || true
	commit=$(plist_get "$app" SlopCommit) || true
	[ -n "$exe" ] && [ -x "$app/Contents/MacOS/$exe" ] || fail "the launcher Contents/MacOS/$exe is missing"
	[ -x "$app/$binary" ] || fail "$binary is missing"
	[ "$min" = "26.0" ] || fail "LSMinimumSystemVersion is '$min', not 26.0"
	[ -e "$app/Contents/Resources/AppIcon.icns" ] || fail "AppIcon.icns is missing"
	echo "$commit" | grep -Eq '^[0-9a-f]{40}(-dirty|-dev)?$' || fail "SlopCommit is '$commit', not a commit"
	ok "Info.plist (commit $commit)"

	local f leftover="" archs
	for f in $(machos "$app"); do
		leftover+=$(otool -L "$f" | grep /nix/store || true)
		archs=$(tools /usr/bin/lipo -archs "$f")
		[ "$archs" = arm64 ] || fail "$f is built for '$archs', not arm64"
	done
	[ -z "$leftover" ] || fail "the bundle still links into /nix/store:"$'\n'"$leftover"
	ok "no /nix/store links, arm64 only"

	codesign --verify --strict --deep "$app" || fail "codesign --verify failed"
	codesign -d --entitlements - --xml "$app/$binary" 2>/dev/null | grep -q com.apple.security.hypervisor ||
		fail "$binary is not signed with the hypervisor entitlement"
	ok "signatures and entitlement"

	local version
	if version=$(env -i HOME="$HOME" PATH=/usr/bin:/bin "$app/$binary" --version 2>&1); then
		case $version in
		*"$commit"*) ok "$binary runs: $version" ;;
		*) fail "$binary --version says '$version', not commit $commit" ;;
		esac
	else
		fail "$binary --version failed: $version"
	fi

	local licenses=$app/Contents/Resources/Licenses lib stem
	[ -s "$licenses/README.txt" ] || fail "Licenses/README.txt is missing"
	for lib in "$app/Contents/Frameworks/"*.dylib; do
		[ -e "$lib" ] || continue
		stem=$(basename "$lib" | sed 's/\..*//')
		grep -qF -e "$stem" -e "${stem#*-}" "$licenses/README.txt" 2>/dev/null ||
			fail "$stem is bundled but not in Licenses/README.txt"
	done
	ok "licenses"

	[ "$failed" -eq 0 ] || exit 1
}

cmd_zip() {
	local app=$1 out=$2
	rm -f "$out"
	/usr/bin/ditto -c -k --sequesterRsrc --keepParent "$app" "$out"
}

[ $# -ge 1 ] || {
	usage >&2
	exit 2
}
command=$1
shift
case $command in
commit) cmd_commit "$@" ;;
plist) cmd_plist "$@" ;;
nix-libs) cmd_nix_libs "$@" ;;
licenses) cmd_licenses "$@" ;;
sign) cmd_sign "$@" ;;
check) cmd_check "$@" ;;
zip) cmd_zip "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
